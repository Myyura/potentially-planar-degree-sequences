private def copies (m : Nat) : List (Fin 7 × Fin 7) :=
  edgeOrder.zipIdx.flatMap fun (e,j) => List.replicate ((m >>> (4*j)) % 16) e

private def check (row : List Nat × Nat) : Bool :=
  let E := copies row.2
  E.all (fun e => support.adj e.1 e.2) &&
    (List.ofFn (fun v => support.degree v+increments E v) == row.1) &&
    (2*E.length+30 == row.1.sum)

set_option maxHeartbeats 0 in
set_option maxRecDepth 32768 in
private theorem rowChecks : rows.all check=true := by decide +kernel

private theorem row_sound {l : List Nat} {m t : Nat} (mem : (l,m)∈rows) (eqn : l.sum=28+2*t) :
    Planaric (List.replicate t 2++l) := by
  obtain ⟨⟨valid,deg⟩,total⟩ := Bool.and_eq_true_iff.mp (List.all_eq_true.mp rowChecks _ mem)
    |>.imp_left Bool.and_eq_true_iff.mp
  let E := copies m
  have ok : ∀ e∈E, support.adj e.1 e.2=true := List.all_eq_true.mp valid
  have degrees : List.ofFn (fun v => support.degree v+increments E v)=l := beq_iff_eq.mp deg
  have sum : 2*E.length+30=l.sum := beq_iff_eq.mp total
  have p := expanded_planaric (H:=support) SevenTight.planar E ok
  rw [degrees] at p
  have pos := List.sum_pos_iff_exists_pos_nat.mp (by omega : 0<l.sum)
  obtain ⟨x,hx,h⟩ := pos
  have pp := planaric_add_two p ⟨x,List.mem_append_right _ hx,h⟩
  have number : t=E.length+1 := by omega
  simpa [number,List.replicate_succ] using pp

/-- Enumerate weakly decreasing lists of a given length with entries
between five and 5+u, preserving the smaller maximum in each tail. -/
private def profiles : Nat → Nat → List (List Nat)
  | 0,_ => [[]]
  | n+1,u => (List.range (u+1)).flatMap fun d => (profiles n d).map ((d+5)::·)

private theorem listed (l : List Nat) (u : Nat) (so : l.Pairwise (·≥·))
    (hm : ∀d∈l, 5≤d ∧ d≤u+5) : l∈profiles l.length u := by
  induction l generalizing u with
  | nil => simp [profiles]
  | cons d l ih =>
    have hd := hm d (by simp)
    apply List.mem_flatMap.mpr
    refine ⟨d-5,List.mem_range.mpr (by omega),List.mem_map.mpr ⟨l,?_,?_⟩⟩
    · apply ih (d-5) so.of_cons
      intro x hx
      have low := (hm x (by simp [hx])).1
      have high := List.rel_of_pairwise_cons so hx
      omega
    · have e : d-5+5=d := by omega
      simp [e]

private def covered (l : List Nat) : Bool := l.sum%2 != 0 ||
  ((rows.map Prod.fst).contains l || l==[9,8,5,5,5,5,5] || l==[9,9,6,5,5,5,5])

set_option maxHeartbeats 0 in
set_option maxRecDepth 32768 in
private theorem coverage : (profiles 7 4).all covered=true := by decide +kernel

/-- Certified bounded region on a single pentagonal bipyramid. -/
theorem bounded {l : List Nat} {t : Nat} (ln : l.length=7) (so : l.Pairwise (·≥·))
    (bounds : ∀d∈l, 5≤d ∧ d≤9) (vol : l.sum=28+2*t) :
    Planaric (List.replicate t 2++l) ∨ l=[9,8,5,5,5,5,5] ∨ l=[9,9,6,5,5,5,5] := by
  have m := listed l 4 so bounds
  rw [ln] at m
  have cover := List.all_eq_true.mp coverage l m
  have even : l.sum%2=0 := by omega
  have checked : ((rows.map Prod.fst).contains l || l==[9,8,5,5,5,5,5] ||
      l==[9,9,6,5,5,5,5])=true := by simpa [covered,even] using cover
  simp only [Bool.or_eq_true,List.contains_eq_mem,decide_eq_true_eq,beq_iff_eq] at checked
  rcases checked with ((h|h)|h)
  · obtain ⟨⟨L,m⟩,mem,eq⟩ := List.mem_map.mp h
    change L=l at eq; subst L
    exact .inl (row_sound mem vol)
  · exact .inr (.inl h)
  · exact .inr (.inr h)

