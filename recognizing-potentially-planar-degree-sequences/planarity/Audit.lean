/- Concrete certificate, parsing, graph-output and layout checks. -/
open Recognition.RotationVerifier SparseBoundary
private def trG := Graph.ofRelation (fun x y : Fin 3 => decide (x ≠ y))
private def trRot : Vector (Fin 3 × Fin 3) 9 := Vector.ofFn fun i =>
  let a : Fin 3 := ⟨i.val/3,by omega⟩
  let b : Fin 3 := ⟨i.val%3,by omega⟩
  (a,-a-b)
private def tr : Raw 3 := ⟨trG,trRot,trRot⟩
private def isoG := Graph.ofRelation (fun _ _ : Fin 4 => false)
private def empty4 : Raw 4 := ⟨isoG,Vector.replicate 16 (0,0),Vector.replicate 16 (0,0)⟩
#guard verify [2,2,2] tr
#guard !verify [2,2,1] tr
#guard verify [0,0,0,0] empty4
#guard !verify [0,1,0,0] empty4

private def path3 : Recognition.StateIso.Colored 3 :=
  ⟨fun _ => 0,fun i j => decide (i.val+1=j.val ∨ j.val+1=i.val)⟩
#guard (Recognition.LayoutSearch.ordered path3 1).isSome
#guard !(Recognition.LayoutSearch.ordered path3 0).isSome
#guard (Recognition.WireOutput.run (Recognition.Wire.degrees [1,2,1])).1.map (fun w => w.2.length) == some 2
#guard (Recognition.WireOutput.run (Recognition.Wire.degrees [0,0])).1.map (fun w => w.2.length) == some 0
#guard (Recognition.WireOutput.run (Recognition.Wire.degrees [2,2,1])).1.isNone
#guard (Recognition.WireOutput.run [true]).1.isNone
